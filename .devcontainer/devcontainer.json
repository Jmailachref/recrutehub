{
  "name": "RecruteHub",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [
    80,
    8000,
    8025,
    8888
  ],
  "portsAttributes": {
    "80": {
      "label": "RecruteHub",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Code Playground"
    },
    "8025": {
      "label": "Mailpit inbox"
    },
    "8888": {
      "label": "File browser"
    }
  },
  "postStartCommand": "sh scripts/start.sh"
}
